{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc-16 build active file",
            "command": "/opt/homebrew/bin/gcc-16",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Chi bien dich, khong chay"
        },
        {
            "type": "shell",
            "label": "C/C++: bien dich va CHAY tep hien tai",
            "command": "/opt/homebrew/bin/gcc-16 -fdiagnostics-color=always -std=gnu11 -Wall -Wextra -g '${file}' -o '${fileDirname}/${fileBasenameNoExtension}' -lm && echo '' && echo '----- chay chuong trinh (go du lieu vao ngay day) -----' && '${fileDirname}/${fileBasenameNoExtension}'",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "revealProblems": "onProblem",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            },
            "detail": "Bien dich roi chay ngay trong terminal tich hop -- nhap duoc du lieu"
        }
    ],
    "version": "2.0.0"
}
